# =============================================================================
# Redacted — Environment Configuration Example
# Copy to .env (or backend/.env) and populate after running scripts/deploy_aws.py
# NEVER commit .env or AWS credentials to version control.
# =============================================================================

# AWS Region where Bedrock AgentCore Managed Harness and S3 are deployed
AWS_REGION=ap-southeast-2

# AWS Credentials (use AWS CLI profile via `aws login --profile redacted` / IAM instance role)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
AWS_PROFILE=redacted

# Amazon Bedrock AgentCore Managed Harness
AGENTCORE_HARNESS_ARN=
AGENTCORE_HARNESS_ID=
AGENTCORE_HARNESS_QUALIFIER=DEFAULT
AGENTCORE_EXECUTION_ROLE_ARN=

# Bedrock Foundation Model & Guardrails
# Active Bedrock model / inference profile in ap-southeast-2.
# Default: amazon.nova-pro-v1:0 (on-demand single-Region in ap-southeast-2; authorized on Free Plan with no Marketplace form).
# Optional Claude alternative (requires 1-time Anthropic use-case form submission): au.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=1

# Amazon S3 Synthetic Document Bucket (Read-Only Access)
S3_DOCUMENTS_BUCKET=
S3_DOCUMENTS_PREFIX=documents/
DOCUMENT_SOURCE_MODE=s3

# Optional AWS Lambda Targets
LAMBDA_RETRIEVER_ARN=
LAMBDA_HOOK_ARN=

# Amazon CloudWatch Security Audit Log Group
CLOUDWATCH_LOG_GROUP=/aws/redacted/security-audit
CLOUDWATCH_LOG_STREAM=backend-security-events

# Backend Security & Session Signing
# Generate a strong secret for production: python -c "import secrets; print(secrets.token_hex(32))"
REDACTED_AUTH_SECRET=change-me-in-local-dev-with-32-byte-secret
REDACTED_AUDIT_DB_PATH=./data/audit_events.db
REDACTED_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REDACTED_PORT=8000
