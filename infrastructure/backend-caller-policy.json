{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeRedactedHarnessOnly",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:InvokeHarness",
        "bedrock-agentcore:InvokeAgentRuntime",
        "bedrock-agentcore:GetHarness",
        "bedrock-agentcore:ListHarnesses"
      ],
      "Resource": "arn:aws:bedrock-agentcore:<REGION>:<ACCOUNT_ID>:harness/<HARNESS_ID>"
    },
    {
      "Sid": "ReadOnlyDocumentS3Access",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::<S3_BUCKET>",
        "arn:aws:s3:::<S3_BUCKET>/documents/*"
      ]
    },
    {
      "Sid": "InvokeReadOnlyRetrieverLambda",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:lambda:<REGION>:<ACCOUNT_ID>:function:redacted-doc-retriever"
    },
    {
      "Sid": "WriteSecurityAuditLogsOnly",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:<REGION>:<ACCOUNT_ID>:log-group:/aws/redacted/security-audit:*"
    },
    {
      "Sid": "ExplicitDenyMutationsAndDirectRuntimeShell",
      "Effect": "Deny",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "bedrock-agentcore:InvokeAgentRuntimeCommand",
        "bedrock-agentcore:InvokeAgentRuntimeCommandShell"
      ],
      "Resource": "*"
    }
  ]
}
