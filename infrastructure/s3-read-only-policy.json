{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::<S3_BUCKET>/documents/*"
    },
    {
      "Sid": "ListBucketManifestPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::<S3_BUCKET>",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "documents/*"
          ]
        }
      }
    },
    {
      "Sid": "DenyAllS3WritesDeletes",
      "Effect": "Deny",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:PutBucketPolicy",
        "s3:DeleteBucket"
      ],
      "Resource": "*"
    }
  ]
}
